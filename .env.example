# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
ENV=development
DATABASE_URL=postgresql://bundleai:bundleai@db:5432/bundleai
SECRET_KEY=change-me-to-a-long-random-string
# Production เท่านั้น (ENV=production): ต้องตั้งทั้งสองค่า และ SECRET_KEY >= 32 ตัวอักษร
ADMIN_PASSWORD=
# SEED_DEMO=1 สร้างบัญชี demo (ค่าเริ่มต้น: เปิดใน development, ปิดใน production)
DEMO_PASSWORD=
